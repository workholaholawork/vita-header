		});

		var currentMinutes = currentHours * 60 + currentMinutesPart;
		var activeItem = null;

		forEachNode(scheduleItems, function (timeElement) {
			var timeValue = timeElement.getAttribute('datetime') || '';
			var timeParts = timeValue.split(':');
