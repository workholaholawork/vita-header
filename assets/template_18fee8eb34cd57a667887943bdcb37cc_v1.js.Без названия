			var itemMinutes = Number(timeParts[0]) * 60 + Number(timeParts[1]);
			if (itemMinutes <= currentMinutes) activeItem = timeElement.closest('.schedule-item');
		});

		if (!activeItem) activeItem = scheduleItems[0].closest('.schedule-item');
		if (!activeItem) return;

		activeItem.classList.add('schedule-item--current');
		var timeBox = activeItem.querySelector('.schedule-time');

