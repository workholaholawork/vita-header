; /* Start:"a:4:{s:4:"full";s:87:"/local/templates/aspro-medc2/components/bitrix/menu/top_custom/script.js?17460303942962";s:6:"source";s:72:"/local/templates/aspro-medc2/components/bitrix/menu/top_custom/script.js";s:3:"min";s:0:"";s:3:"map";s:0:"";}"*/

if($(window).width() <= 991) {

    let desktopMenu = $('.menu-row'),
        mobileNavMenu = $('#mobilemenu .menu .top');

    desktopMenu.find('.menu-item').replaceWith(function() {

        //Убираем лишний span
        $(this).find('.tail').remove();

        //Заменяем класс активности на мобильный
        $(this).find('li').each(function() {
            if($(this).hasClass('active')) {
                $(this).addClass('selected').removeClass('active');
            }
        })

        //Убираем wrap
        $(this).find('.wrap').each(function() {
            $(this).replaceWith($(this).contents());
        });

        $(this).find('.dropdown-menu').each(function() {

            let linkSection = $(this).parent().find(' > .dropdown-toggle'); //Получаем ссылку родительского раздела

            $(this).addClass('dropdown').removeClass('dropdown-menu'); //Заменяем класс ul на мобильный
            $(this).siblings('a').addClass('parent'); //Добавляем ссылке, находящейся на одном уровне с ul, родительский класс

            //Добавляем кнопку "Назад" и ссылку у разделов с подразделами
            $(this).prepend('<li class="menu_back">' +
                    '<a href="" class="dark-color" rel="nofollow">' + '<i class="svg svg-arrow-right"></i>Назад</a>' +
                '</li>' +
                '<li class="menu_title">' +
                    '<a class="dark-color" href="'+ linkSection.attr('href') +'">' + linkSection.text().trim() + '</a>' +
                '</li>'
            );
        });

        //Заменяем класс у li
        $(this).find('.dropdown-submenu').each(function() {
            $(this).removeClass('dropdown-submenu');
        })

        //Заменяем класс у родительского тэга "a"
        $(this).find('.dropdown-toggle').each(function() {
            $(this).addClass('parent').removeClass('dropdown-toggle');
        })

        //Добавляем мобильный класс всем ссылкам
        $(this).find('a').each(function() {
            $(this).addClass('dark-color');

            //Добавляем значок "стрелы" к ссылке если у раздела есть подразделы
            if($(this).hasClass('parent')) {
                $(this).append('<span class="arrow"><i class="svg svg_triangle_right"></i></span>');
            }
        })

        let mobileMenuItemClass = $(this).hasClass('active') ? 'mobile-menu-item selected' : 'mobile-menu-item';

        return $('<li>', {
            class: mobileMenuItemClass,
            html: $(this).html()
        });
    });
    desktopMenu.find('.mobile-menu-item').each(function () {
        mobileNavMenu.append($(this));
    })
}

