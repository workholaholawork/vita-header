; /* Start:"a:4:{s:4:"full";s:96:"/local/templates/aspro-medc2/components/bitrix/news.detail/main-objects/script.js?17425543322814";s:6:"source";s:81:"/local/templates/aspro-medc2/components/bitrix/news.detail/main-objects/script.js";s:3:"min";s:0:"";s:3:"map";s:0:"";}"*/
$(document).ready(function() {
    $('#readMoreBtn').on('click', function (e) {
        e.preventDefault();

        let full_text = $('.about__text');
        let preview_text = $('.about__preview');

        if(full_text.hasClass('conceal')) {
            preview_text.removeClass("about__blur");
            full_text.removeClass("conceal").show(1000);
            $(this).text("Свернуть");
        } else {
            preview_text.addClass("about__blur");
            full_text.hide(1000).addClass("conceal");
            $(this).text("Читать далее");
        }
    });

    let swiperList = new Swiper('.custom-swiper', {
        slidesPerView: 'auto',
        spaceBetween: 19,
        loop: true,
        grabCursor: true,
        navigation: {
            nextEl: '.custom-swiper-button-next',
            prevEl: '.custom-swiper-button-prev',
        },
    });

    $(window).scroll( (event) => {
        let scrolled = $(window).scrollTop(),
            formCalculate = $('.form__calculate'),
            aboutVideo = $('.about__video'),
            startBlockVideo = $('.about').offset().top - 550,
            startFormCalculate = formCalculate.offset().top - 800,
            srcVideo = aboutVideo.attr('data-src-video');
        if(!$('.form__calculate div').length){
            if(scrolled > startFormCalculate) {
                formCalculate.append('<div data-marquiz-id="65e1d7cf337c0a00263ec950"></div>');

                //Marquiz script start

                (function(w, d, s, o){
                    var j = d.createElement(s); j.async = true; j.src = '//script.marquiz.ru/v2.js';j.onload = function() {
                        if (document.readyState !== 'loading') Marquiz.init(o);
                        else document.addEventListener("DOMContentLoaded", function() {
                            Marquiz.init(o);
                        });
                    };
                    d.head.insertBefore(j, d.head.firstElementChild);
                })
                (window, document, 'script', {
                        host: '//quiz.marquiz.ru',
                        region: 'eu',
                        id: '65e1c4fa4e81ea00266a4bb9',
                        autoOpen: false,
                        autoOpenFreq: 'once',
                        openOnExit: false,
                        disableOnMobile: false
                    }
                );

                //Marquiz script end
            }
        }
        if(!$('#video_block_about').length){
            if(scrolled > startBlockVideo){
                aboutVideo.append('<iframe width="674" id="video_block_about" height="434" src="'+ srcVideo +'" frameborder="0" allowfullscreen></iframe>');
                aboutVideo.removeAttr('data-src-video');
            }
        }
    });
});
