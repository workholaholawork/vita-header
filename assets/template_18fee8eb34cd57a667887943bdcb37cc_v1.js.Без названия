(function (window, document) {
	'use strict';

	var forEachNode = function (nodes, callback) {
		Array.prototype.forEach.call(nodes, callback);
	};

	var initTabs = function (root) {
		var wrap = root.querySelector('#care-tabs');
		if (!wrap || wrap.getAttribute('data-vita-tabs-ready') === 'true') return;

		var buttons = wrap.querySelectorAll('.tabs-nav button');
		var panels = wrap.querySelectorAll('.tab-panel');
		wrap.setAttribute('data-vita-tabs-ready', 'true');

		forEachNode(buttons, function (button) {
			button.addEventListener('click', function () {
				forEachNode(buttons, function (item) {
					item.classList.remove('active');
					item.setAttribute('aria-selected', 'false');
				});

				forEachNode(panels, function (panel) {
					panel.classList.remove('active');
				});

				button.classList.add('active');
				button.setAttribute('aria-selected', 'true');

				var targetId = button.getAttribute('data-tab');
				var target = targetId ? document.getElementById(targetId) : null;
				if (target && root.contains(target)) target.classList.add('active');
			});
		});
	};

	var initToc = function (root) {
		var tocBlocks = root.querySelectorAll('.toc-block');

		forEachNode(tocBlocks, function (toc) {
			if (toc.getAttribute('data-vita-toc-ready') === 'true') return;
			toc.setAttribute('data-vita-toc-ready', 'true');

			var mobileQuery = window.matchMedia('(max-width: 767px)');
			var placeholder = document.createElement('div');
			var isFixed = false;
			var originTop = 0;
			var ticking = false;

			placeholder.className = 'toc-sticky-placeholder';
			toc.parentNode.insertBefore(placeholder, toc);

			var getHeaderBottom = function () {
				var header = document.querySelector('.mobile_header_top');
				if (!header) return 0;
				return Math.max(0, header.getBoundingClientRect().bottom);
			};

			var clearFixedState = function () {
				toc.classList.remove('toc-block--fixed');
				toc.style.removeProperty('top');
				toc.style.removeProperty('left');
				toc.style.removeProperty('width');
				toc.style.removeProperty('--toc-fixed-top');
				placeholder.style.height = '0';
				isFixed = false;
			};

			var update = function () {
				ticking = false;

				if (!mobileQuery.matches) {
					clearFixedState();
					toc.setAttribute('open', '');
					originTop = toc.getBoundingClientRect().top + window.pageYOffset;
					return;
				}

				if (!isFixed) originTop = toc.getBoundingClientRect().top + window.pageYOffset;

				var fixedTop = getHeaderBottom();
				var shouldFix = window.pageYOffset + fixedTop >= originTop;

				if (shouldFix && !isFixed) {
					toc.removeAttribute('open');

					var tocRect = toc.getBoundingClientRect();
					var tocStyles = window.getComputedStyle(toc);
					var reservedHeight = toc.offsetHeight + parseFloat(tocStyles.marginTop || 0) + parseFloat(tocStyles.marginBottom || 0);

					placeholder.style.height = reservedHeight + 'px';
					toc.classList.add('toc-block--fixed');
					toc.style.left = tocRect.left + 'px';
					toc.style.width = tocRect.width + 'px';
					isFixed = true;
				} else if (!shouldFix && isFixed) {
					toc.removeAttribute('open');
					clearFixedState();
					originTop = toc.getBoundingClientRect().top + window.pageYOffset;
					return;
				}

				if (isFixed) {
					var placeholderRect = placeholder.getBoundingClientRect();
					toc.style.top = fixedTop + 'px';
					toc.style.left = placeholderRect.left + 'px';
					toc.style.width = placeholderRect.width + 'px';
					toc.style.setProperty('--toc-fixed-top', fixedTop + 'px');
				}
			};

			var requestUpdate = function () {
				if (ticking) return;
				ticking = true;
				window.requestAnimationFrame(update);
			};

			toc.removeAttribute('open');
			update();
			window.addEventListener('scroll', requestUpdate, { passive: true });
			window.addEventListener('resize', requestUpdate);
		});
	};

	var initSchedule = function (root) {
		var scheduleItems = root.querySelectorAll('.schedule-item time');
		if (!scheduleItems.length || scheduleItems[0].getAttribute('data-vita-schedule-ready') === 'true') return;

		scheduleItems[0].setAttribute('data-vita-schedule-ready', 'true');

		var moscowParts = new Intl.DateTimeFormat('en-GB', {
			timeZone: 'Europe/Moscow',
			hour: '2-digit',
			minute: '2-digit',
			hourCycle: 'h23'
