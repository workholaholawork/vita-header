				if (document.contains(activeTrigger)) activeTrigger.focus();
			}

			activeTrigger = null;
			activeModal = null;
		};

		forEachNode(triggers, function (trigger) {
			if (trigger.getAttribute('data-vita-route-ready') === 'true') return;

			var routeId = trigger.getAttribute('data-popup');
			var modal = routeId ? root.querySelector('[data-route-modal="' + routeId + '"]') : null;
			if (!modal) return;

			var dialog = modal.querySelector('.route-popup__dialog');
			var closeButtons = modal.querySelectorAll('[data-route-close]');
			trigger.setAttribute('data-vita-route-ready', 'true');
			trigger.setAttribute('aria-expanded', 'false');

			trigger.addEventListener('click', function () {
				if (activeModal && activeModal !== modal) closeRouteModal();
				activeTrigger = trigger;
				activeModal = modal;
				modal.classList.add('is-open');
				modal.setAttribute('aria-hidden', 'false');
				trigger.setAttribute('aria-expanded', 'true');
				if (dialog) dialog.focus();
			});

			forEachNode(closeButtons, function (button) {
				button.addEventListener('click', closeRouteModal);
			});
		});

		if (root.getAttribute('data-vita-route-keyboard-ready') !== 'true') {
			root.setAttribute('data-vita-route-keyboard-ready', 'true');
			document.addEventListener('keydown', function (event) {
				if (event.key === 'Escape') closeRouteModal();
			});
		}
	};

	var removeMobileTabHeading = function () {
		var description = document.querySelector('.detail.services-custom #desc');
		if (!description) return;

		var removeHeading = function () {
			var heading = document.querySelector('.detail.services-custom #desc > .title-tab-heading.visible-xs');
			if (heading) heading.remove();
		};

		removeHeading();

		if (window.MutationObserver && description.getAttribute('data-vita-heading-observer') !== 'true') {
