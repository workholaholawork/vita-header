; /* Start:"a:4:{s:4:"full";s:99:"/local/templates/aspro-medc2/components/bitrix/news.list/main.schedule.list/script.js?1742554341699";s:6:"source";s:85:"/local/templates/aspro-medc2/components/bitrix/news.list/main.schedule.list/script.js";s:3:"min";s:0:"";s:3:"map";s:0:"";}"*/
const scheduleItems = document.querySelectorAll('.schedule__item');
const scheduleContents = document.querySelectorAll('.schedule__content');

function setActiveClass(index) {
    for (let i = 0; i < scheduleItems.length; i++) {
        if (i === index) {
            scheduleItems[i].classList.add('schedule__item--active');
            scheduleContents[i].style.display = 'flex';
        } else {
            scheduleItems[i].classList.remove('schedule__item--active');
            scheduleContents[i].style.display = 'none';
        }
    }
}

setActiveClass(0);

scheduleItems.forEach((item, index) => {
    item.addEventListener('click', function () {
        setActiveClass(index);
    });
});
